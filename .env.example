POSTGRES_DB=finsight_ai
POSTGRES_USER=finsight
POSTGRES_PASSWORD=finsight
POSTGRES_PORT=5434

REDIS_PORT=6379

DATABASE_URL=postgresql://finsight:finsight@localhost:5434/finsight_ai
REDIS_URL=redis://localhost:6379

TEST_DATABASE_URL=postgresql://finsight:finsight@localhost:5434/finsight_ai
TEST_REDIS_URL=redis://localhost:6379

AUTH_SECRET=replace-with-a-generated-secret
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

AUTH_GOOGLE_ID=replace-with-google-client-id
AUTH_GOOGLE_SECRET=replace-with-google-client-secret

AUTH_GITHUB_ID=replace-with-github-client-id
AUTH_GITHUB_SECRET=replace-with-github-client-secret

# Chat com IA (OpenAI via Vercel AI SDK).
# Sem a chave, a aplicação sobe normalmente e POST /api/ai/chat responde 503.
OPENAI_API_KEY=
# Opcional: sobrescreve o modelo padrão do chat.
OPENAI_CHAT_MODEL=gpt-5.4-mini
